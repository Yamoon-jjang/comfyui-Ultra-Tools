      },
      "Shadow_Color": {
        "name": "그림자 Hex",
        "description": "#RRGGBB 형식입니다. 그림자 색상 선택이 custom hex일 때 사용됩니다."
      },
      "Shadow_Opacity": {
        "name": "그림자 불투명도"
