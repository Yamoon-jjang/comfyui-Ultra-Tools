      "── 🌑 Shadow ──": {
        "name": "── 🌑 그림자 ──"
      },
      "Shadow_Enabled": {
        "name": "그림자 사용"
      },
      "Shadow_Color_Preset": {
        "name": "그림자 색상 선택",
