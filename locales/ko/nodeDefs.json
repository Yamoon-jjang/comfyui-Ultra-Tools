  "UltraPromptStyler": {
    "display_name": "Ultra Tools Prompt Styler",
    "description": "외부 프롬프트 본문은 유지하면서, 선택한 모델 형식에 맞춰 분위기·스타일·구도·카메라 느낌을 문구로 보강해 최종 Positive / Negative 프롬프트를 만드는 프롬프트 스타일 노드입니다. 필요하면 성인 톤, 의상, 추가 문구도 함께 정리할 수 있습니다.",
    "inputs": {
      "model_profile": {
        "name": "모델 형식",
        "description": "사용할 모델 계열의 프롬프트 형식입니다. Z-Image/Qwen/Flux는 자연어, Anima는 태그와 짧은 문장을 함께 쓰는 혼합형, SDXL/ILXL/Pony/SD는 태그형 중심으로 출력합니다."
      },
      "mood_family": {
        "name": "분위기",
        "description": "프롬프트에 더할 감정과 분위기 방향입니다. 따뜻함, 서정성, 긴장감, 몽환감처럼 장면의 느낌을 조절합니다."
      },
      "adult_tone": {
        "name": "성인 표현 톤",
        "description": "기본 표현부터 NSFW까지 성인 톤의 강도를 조절합니다. 기본값은 성인/NSFW 관련 문구를 따로 추가하지 않습니다."
      },
      "adult_wardrobe": {
        "name": "성인 의상",
        "description": "성인 톤에서 사용할 의상이나 노출 방향을 고릅니다. 자동 / 미지정은 의상 힌트를 추가하지 않습니다."
      },
      "style_dna": {
        "name": "스타일 방향",
        "description": "색감, 조명, 재료감, 그림체, 화면 질감처럼 실제 출력 문구에 들어갈 시각 표현 방향입니다. “분위기에 맞춰 자동”은 선택한 분위기에 어울리는 스타일을 자동으로 고릅니다."
      },
      "style_strength": {
        "name": "스타일 반영 방식",
        "description": "스타일을 적용할지 말지를 고르는 옵션이 아니라, 원본 프롬프트를 얼마나 보존할지와 선택한 스타일을 얼마나 앞세울지를 정합니다. 원본 보존은 스타일을 가볍게 덧입히고, 균형 적용은 두 요소를 균형 있게 반영하며, 스타일 우선은 선택한 스타일이 더 분명하게 드러나도록 문구를 구성합니다."
      },
      "style_conflict_cleanup": {
        "name": "스타일 방해 문구 정리",
        "description": "Z-Image/Qwen/Flux 같은 자연어 모델에서만 동작하는 선택형 기능입니다. 공통 삭제가 아니라 선택한 스타일별 conflict profile에 따라, 그 스타일을 직접 방해하는 외부 프롬프트 문구만 완화합니다. 예: 치비는 현실 성인 신체비율 문구, 빈티지 필름은 현대 디지털/HDR 문구, 수채화·스케치 계열은 사진 렌즈/피부 질감 문구를 중심으로 정리합니다. 기본값 끔은 원본을 그대로 둡니다. 태그형 모델에는 적용하지 않습니다."
      },
      "scene_framing": {
        "name": "구도 / 화면 범위",
        "description": "얼굴 중심, 상반신, 전신, 넓은 배경 포함처럼 피사체가 화면 안에 어느 정도 보일지 정합니다."
      },
      "lens_preset": {
        "name": "카메라 / 렌즈 느낌",
        "description": "카메라 시점과 렌즈 느낌을 정합니다. 예: 넓은 화면, 자연스러운 인물, 배경 흐림, 아래에서 올려다봄. 필요 없으면 자동을 사용하세요."
      },
      "external_prompt_mode": {
        "name": "원본 프롬프트와 합치기",
        "description": "외부 Positive 프롬프트가 있을 때 스타일 문구를 어디에 붙일지 정합니다. 기본값은 원본 본문을 먼저 보존하고 뒤에 스타일 문구를 추가합니다."
      },
      "seed": {
        "name": "시드",
        "description": "고정 시드입니다. 0도 고정값으로 재현되며, 무작위 실행은 ComfyUI의 seed control/randomize 기능을 사용합니다."
      },
      "custom_text": {
        "name": "추가 문구",
        "description": "마지막에 더할 자유 영문 문구입니다. 장소, 의상, 소품, 배경 같은 구체 요소나 보조 스타일 힌트를 직접 적을 수 있습니다. 예) modern city skyline, luxury living room, black dress, night street"
      },
