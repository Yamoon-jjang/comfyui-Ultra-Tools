  "UltraImageWatermark": {
    "display_name": "Ultra Tools Image Watermark",
    "description": "로고/서명/아이콘 이미지를 워터마크로 삽입합니다. 워터마크 파일 드롭다운은 ComfyUI input 폴더에 이미 있는 파일 목록을 보여주며, 새 파일은 노드의 “워터마크 파일 업로드/선택” 버튼으로 OS 파일 선택창을 열어 업로드한 뒤 바로 사용할 수 있습니다. 기존처럼 IMAGE/MASK 연결도 사용할 수 있고, 투명 PNG/WebP의 alpha는 자동으로 마스크 처리됩니다.",
    "inputs": {
      "image": {
        "name": "이미지"
      },
      "watermark": {
        "name": "워터마크 파일",
        "description": "ComfyUI input 폴더에 이미 들어 있는 워터마크 PNG/JPG/WebP 목록입니다. 이 칸 자체는 OS 파일 탐색기를 열지 않습니다. 새 파일은 노드에 추가된 “워터마크 파일 업로드/선택” 버튼으로 선택/업로드하면 이 값이 자동으로 갱신됩니다. watermark_image 연결이 있으면 연결 입력이 우선됩니다."
      },
      "watermark_image": {
        "name": "워터마크 이미지",
        "description": "기존 방식 호환용 IMAGE 입력입니다. 연결하면 위 watermark 파일 선택보다 우선 사용됩니다."
      },
      "── 🖼️ Watermark Image ──": {
        "name": "── 🖼️ 워터마크 이미지 ──"
      },
      "Size_Mode": {
        "name": "크기 모드"
      },
      "Scale_Percent": {
        "name": "크기 비율 (%)",
        "description": "percentage 모드에서 사용합니다. 원본 이미지의 짧은 변을 기준으로, 워터마크의 보이는 영역 중 긴 변을 이 비율에 맞춥니다."
      },
      "Pixel_Width": {
        "name": "픽셀 크기 (긴 변)",
        "description": "pixels 모드에서 사용합니다. 워터마크의 보이는 영역 중 긴 변을 이 픽셀값에 맞춥니다. 투명 여백은 크기 계산에서 제외됩니다."
      },
      "Invert_Colors": {
        "name": "색상 반전",
        "description": "워터마크의 RGB를 반전합니다. 색상 틴트가 켜져 있으면 무시됩니다."
      },
      "Color_Tint": {
        "name": "색상 틴트 사용",
        "description": "워터마크의 모든 색상을 틴트 색상으로 교체합니다."
      },
      "Tint_Color_Preset": {
        "name": "틴트 색상 선택",
        "description": "프리셋 색상을 선택합니다. custom hex를 선택하면 아래 틴트 Hex 값을 사용합니다."
